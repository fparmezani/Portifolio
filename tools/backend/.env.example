# Copie para .env local / Hostinger (não commite valores reais).

ANTHROPIC_API_KEY=sk-ant-...
ALLOWED_ORIGINS=https://fernandoparmezani.com.br,https://www.fernandoparmezani.com.br,https://tools.fernandoparmezani.com.br,https://kits.fernandoparmezani.com.br
RAIO_X_PER_USER_HOUR=20
RAIO_X_PER_DAY=200
RAIO_X_MODEL=claude-sonnet-5-5
PORT=3001

# Supabase (Project Settings → API) — URL sem /rest/v1/
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe — use sk_test_ / whsec_ de TEST enquanto validamos; depois sk_live_
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CREDITS=price_...
STRIPE_CREDITS_PER_PACK=100
# Redirect do NAVEGADOR após o Checkout (página do site). Não use api.* —
# o webhook da API é /webhooks/stripe. ?credits=ok mostra o aviso no front.
STRIPE_SUCCESS_URL=https://fernandoparmezani.com.br/tools/?credits=ok
STRIPE_CANCEL_URL=https://fernandoparmezani.com.br/tools/?credits=cancel
